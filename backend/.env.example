# ============================================================
# FACT-KARD — variables de entorno del backend
# Copia este archivo a backend/.env y completa los valores.
# NUNCA subas backend/.env al repositorio.
#
# Este archivo trae valores de DESARROLLO. La plantilla completa de producción
# (VPS, sistema.asescon.net) está en deploy/env.produccion.example.
# ============================================================

# --- Seguridad (SEC-001) ------------------------------------
# DEBUG debe activarse explícitamente. En producción: False.
DEBUG=True

# Obligatoria en producción (DEBUG=False). Debe tener 50+ caracteres
# y no puede ser un valor de ejemplo. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Con DEBUG=True y sin valor, se genera una clave local en backend/.secret_key.dev.
# Cambiar esta clave invalida todos los tokens de sesión emitidos.
SECRET_KEY=

# Hosts que puede servir Django, separados por coma. '*' no se permite con DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo se respeta con DEBUG=True. En producción siempre queda en False.
CORS_ALLOW_ALL_ORIGINS=False

# Orígenes HTTPS confiables para CSRF en producción (ej. https://app.midominio.pe).
CSRF_TRUSTED_ORIGINS=

# Opcionales de producción (por defecto: cookies seguras si DEBUG=False).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True   (solo afecta a *.sistema.asescon.net)
# Detrás de un proxy inverso que termina HTTPS (nginx / balanceador):
# SECURE_PROXY_SSL_HEADER_HTTPS=True
# Nº de proxies confiables delante de Django (Nginx = 1). En desarrollo: 0.
# Con 0 se usa la IP de la conexión; nunca un X-Forwarded-For enviado por el cliente.
NUM_PROXIES=0
# Intranet sin certificado (excepción explícita, ver docs/PRODUCCION.md):
# PRODUCCION_SIN_HTTPS=False

# --- Sesión (Bloques 6 y 7) ---------------------------------
# Duración del token en segundos. Producción: 28800–43200 (8–12 h).
# TOKEN_MAX_AGE_SECONDS=604800
# LOGIN_THROTTLE_RATE=10/min
# Sesión por cookie HttpOnly: preparada pero APAGADA. Activarla exige migrar el
# frontend (docs/SEGURIDAD_TOKEN_LOCALSTORAGE.md).
# AUTH_COOKIE_ENABLED=False
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_DOMAIN=

# --- Caché (Bloque 7) ---------------------------------------
# Vacía = memoria local (desarrollo, sin Redis). Producción: Redis compartido
# (pip install -r requirements-prod.txt).
# CACHE_URL=redis://localhost:6379/0
# CACHE_KEY_PREFIX=fact-kard

# --- Base de datos -----------------------------------------
DB_NAME=fact_kard
DB_USER=fact_kard_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Conexiones persistentes (segundos). Producción: 60.
# DB_CONN_MAX_AGE=0

# --- Bloque 8: estáticos, logs y documentación de la API -------------
# STATIC_ROOT=/srv/fact-kard/app/backend/staticfiles   (lo sirve Nginx en /static/)
# LOG_LEVEL=INFO
# Sin LOG_FILE los logs van a stdout (journald con systemd). Con archivo: rotación por tamaño.
# LOG_FILE=/var/log/fact-kard/fact-kard.log
# LOG_FILE_MAX_MB=20
# LOG_FILE_BACKUPS=10
# Swagger/OpenAPI (/api/docs/, /api/schema/). Vacía = sigue a DEBUG (encendida en
# desarrollo, apagada en producción). True/False = decisión explícita; en producción
# (DEBUG=False) encendida exige usuario autenticado.
# API_DOCS_ENABLED=

# --- Bloque 8: Gunicorn (producción) ----------------------------------
# GUNICORN_BIND=127.0.0.1:8001
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
